# Not needed for local dev — client.ts falls back to
# http://localhost:8000/api/v1 when this is unset.
#
# Required for a deployed (e.g. Vercel) frontend: point at wherever the
# backend actually runs. Vite only exposes vars prefixed VITE_ to client
# code, and only bakes them in at build time (not read at runtime), so
# this must be set in Vercel's project env vars before each build/deploy,
# not just in a local file.
VITE_API_BASE=http://localhost:8000/api/v1
